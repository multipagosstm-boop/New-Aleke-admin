    },
    "cliente_id": {
      "type": "string"
    },
    "credito_id": {
      "type": "string",
      "description": "FK a EmprendamosCredito sobre el que se generaron los intereses"
    },
    "periodo": {
      "type": "string",
      "description": "Per\u00edodo cargado, formato YYYY-MM"
    },
    "capital_base": {
      "type": "number"
    },
    "tasa": {
      "type": "number"
    },
    "intereses": {
      "type": "number"
    },
    "comprobante_id": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "generado",
        "anulado"
      ],
      "default": "generado"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
